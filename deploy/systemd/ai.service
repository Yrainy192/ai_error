[Unit]
Description=RK3588 YOLOv8 AI Service
After=network.target


[Service]

Type=simple

User=admin

WorkingDirectory=/home/admin/Rtsp_6model/rknn_demo_release

ExecStart=/home/admin/Rtsp_6model/rknn_demo_release/rknn_yolov8_demo_zero_copy


Restart=always

RestartSec=3


Environment=LD_LIBRARY_PATH=/usr/lib:/usr/lib/aarch64-linux-gnu


[Install]

WantedBy=multi-user.target
